#!/bin/sh
# Refuse a commit message that closes an issue without acknowledging it.
#
# Enable per clone (hooks are not tracked into .git/hooks by git), unless the
# clone already sets a hooks directory. If
#
#     git config --get core.hooksPath
#
# prints a value, keep it, and have that directory's commit-msg run this file.
# Otherwise:
#
#     git config core.hooksPath .githooks
#
# which replaces a local value and overrides a global one with no warning.
# The hook only exists on branches that contain it, and a clone whose hooks
# directory does not run it has no guard at all. CI re-runs the same check on the
# pull request, which is the copy that actually gates a merge.

set -e

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  # Fail loudly. A guard whose failure mode is silence is worse than no guard:
  # it reads as "all clear" every single time.
  echo "commit-msg: no python on PATH, cannot check for unacknowledged closes." >&2
  echo "  Install python, or bypass this one commit with --no-verify." >&2
  exit 1
fi

exec "$PY" "$(git rev-parse --show-toplevel)/scripts/check_closing_keywords.py" \
  --commit-msg "$1"
